@model Licitaciones.Web.Models.Proveedores.ProveedorIndexViewModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Proveedores</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

@if (!Model.Proveedores.Any())
{
    <p class="text-muted">No hay proveedores registrados que coincidan con la búsqueda.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Creado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var proveedor in Model.Proveedores)
        {
            <tr>
                <td>@proveedor.Nombre</td>
                <td>@proveedor.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@proveedor.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@proveedor.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginación de proveedores">
            <ul class="pagination">
                @for (var i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@Model.Busqueda">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
