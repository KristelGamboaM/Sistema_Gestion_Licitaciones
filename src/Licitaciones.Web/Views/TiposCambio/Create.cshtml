@model Licitaciones.Web.Models.TiposCambio.TipoCambioFormViewModel
@{
    ViewData["Title"] = "Nuevo tipo de cambio";
}

<h1>Nuevo tipo de cambio</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="CRCporUSD" class="form-label"></label>
                <input asp-for="CRCporUSD" type="number" step="0.000001" min="0.000001" class="form-control" />
                <span asp-validation-for="CRCporUSD" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FechaVigencia" class="form-label"></label>
                <input asp-for="FechaVigencia" type="date" class="form-control" />
                <span asp-validation-for="FechaVigencia" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
