@model Licitaciones.Web.Models.Ofertas.OfertaFormViewModel
@{
    ViewData["Title"] = "Editar oferta";
}

<h1>Editar oferta — @Model.LicitacionCodigo</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="LicitacionId" />
            <div class="mb-3">
                <label class="form-label">Proveedor</label>
                <input type="text" class="form-control" value="@Model.ProveedoresDisponibles.First().Nombre" disabled />
            </div>
            <div class="mb-3">
                <label asp-for="MontoOfertadoCRC" class="form-label"></label>
                <input asp-for="MontoOfertadoCRC" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="MontoOfertadoCRC" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" asp-route-licitacionId="@Model.LicitacionId" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
