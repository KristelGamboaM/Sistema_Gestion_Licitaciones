@model Licitaciones.Web.Models.Ofertas.OfertaFormViewModel
@{
    ViewData["Title"] = "Nueva oferta";
}

<h1>Nueva oferta — @Model.LicitacionCodigo</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="LicitacionId" />
            <div class="mb-3">
                <label asp-for="ProveedorId" class="form-label"></label>
                <select asp-for="ProveedorId" class="form-select"
                        asp-items="@(new SelectList(Model.ProveedoresDisponibles, "Id", "Nombre"))">
                    <option value="">-- Seleccione un proveedor --</option>
                </select>
                <span asp-validation-for="ProveedorId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MontoOfertadoCRC" class="form-label"></label>
                <input asp-for="MontoOfertadoCRC" type="number" step="0.01" min="0.01" class="form-control" />
                <span asp-validation-for="MontoOfertadoCRC" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" asp-route-licitacionId="@Model.LicitacionId" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
