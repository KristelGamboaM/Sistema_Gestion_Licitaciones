@model Licitaciones.Application.NivelesAprobacion.NivelAprobacionDto
@{
    ViewData["Title"] = "Eliminar nivel de aprobación";
}

<h1>Eliminar nivel de aprobación</h1>

<div class="alert alert-warning">
    ¿Confirma que desea eliminar el nivel de aprobación de <strong>@Model.Aprobador</strong>?
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
